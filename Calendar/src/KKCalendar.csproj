<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 は Windows 10/11 に標準搭載なので、exe をコピーするだけで動く -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>KKCalendar</AssemblyName>
    <RootNamespace>KKCalendar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\KKCalendar.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>KKCalendar</Product>
    <Description>日本の祝日と六曜が分かるカレンダー</Description>
    <Copyright>KKCalendar</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内閣府「国民の祝日」CSV の出荷時のスナップショット（Shift_JIS のまま）。オンライン更新後はダウンロードしたものが優先 -->
    <EmbeddedResource Include="Data\syukujitsu.csv" LogicalName="syukujitsu.csv" />
    <Resource Include="Assets\KKCalendar.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KKCalendar.Tests" />
  </ItemGroup>

</Project>
